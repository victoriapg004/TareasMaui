<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:TareasMaui.Models"
    x:Class="TareasMaui.MainPage"
    Title="Lista de tareas"
    BackgroundColor="#F5F5FA">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="12">

        <Label
            Grid.Row="0"
            Text="Mis tareas"
            FontSize="28"
            FontAttributes="Bold"
            TextColor="#30244F"
            SemanticProperties.HeadingLevel="Level1"/>

        <Grid Grid.Row="1"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="10">
            <Button
                Grid.Column="0"
                Text="Nueva tarea"
                BackgroundColor="#512BD4"
                TextColor="White"
                CornerRadius="10"
                Clicked="OnNuevaTareaClicked"/>

            <Button
                Grid.Column="1"
                x:Name="btnActualizar"
                Text="Actualizar"
                BackgroundColor="White"
                TextColor="#512BD4"
                BorderColor="#512BD4"
                BorderWidth="1"
                CornerRadius="10"
                Clicked="OnActualizarClicked"/>
        </Grid>

        <Border
            Grid.Row="2"
            x:Name="bannerEstado"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 8"
            Padding="12,8"
            IsVisible="False">
            <HorizontalStackLayout Spacing="10">
                <ActivityIndicator
                    x:Name="indicadorCarga"
                    IsRunning="False"
                    IsVisible="False"
                    Color="#512BD4"
                    HeightRequest="20"
                    WidthRequest="20"/>
                <Label
                    x:Name="lblEstado"
                    FontSize="14"
                    VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>

        <RefreshView
            Grid.Row="3"
            x:Name="refreshView"
            Refreshing="OnRefreshing">

            <CollectionView
                x:Name="listaTareas"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label
                        Text="No hay tareas registradas."
                        FontSize="16"
                        TextColor="#666666"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Tarea">

                        <Border
                            BackgroundColor="White"
                            Stroke="#DDDDDD"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="15"
                            Margin="0,5">

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    Text="{Binding Titulo}"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="#30244F"/>

                                <Label
                                    Text="{Binding Descripcion}"
                                    FontSize="15"
                                    TextColor="#555555"/>

                                <HorizontalStackLayout Spacing="8">

                                    <Label
                                        Text="Prioridad:"
                                        FontAttributes="Bold"
                                        TextColor="#30244F"
                                        VerticalOptions="Center"/>

                                    <Border
                                        BackgroundColor="{Binding ColorPrioridad}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="10,2">
                                        <Label
                                            Text="{Binding Prioridad}"
                                            TextColor="White"
                                            FontSize="13"
                                            FontAttributes="Bold"/>
                                    </Border>

                                </HorizontalStackLayout>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>