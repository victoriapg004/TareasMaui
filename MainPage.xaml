<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:TareasMaui.Models"
    x:Class="TareasMaui.MainPage"
    Title="Lista de tareas"
    BackgroundColor="#F5F5FA">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="15">

        <Label
            Grid.Row="0"
            Text="Mis tareas"
            FontSize="28"
            FontAttributes="Bold"
            TextColor="#30244F" />

        <Button
            Grid.Row="1"
            Text="Nueva tarea"
            BackgroundColor="#512BD4"
            TextColor="White"
            CornerRadius="10"
            Clicked="OnNuevaTareaClicked" />

        <CollectionView
            Grid.Row="2"
            x:Name="listaTareas"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <Label
                    Text="No hay tareas registradas."
                    FontSize="16"
                    TextColor="#666666"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Tarea">

                    <Border
                        BackgroundColor="White"
                        Stroke="#DDDDDD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="15"
                        Margin="0,5">

                        <VerticalStackLayout Spacing="10">

                            <Label
                                Text="{Binding Titulo}"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="#30244F" />

                            <Label
                                Text="{Binding Descripcion}"
                                FontSize="15"
                                TextColor="#555555" />

                            <HorizontalStackLayout Spacing="5">

                                <Label
                                    Text="Prioridad:"
                                    FontAttributes="Bold"
                                    TextColor="#30244F" />

                                <Label
                                    Text="{Binding Prioridad}"
                                    TextColor="#512BD4" />

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
